<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <Dialog title="Add Employee Details" id="addEmpDialog">
        <Label text = "Name" labelFor = "inputName2"></Label>
        <Input id = "inputName2" placeholder="Enter Name" value="{oModel>/name}"></Input>
        <Label text = "Age" labelFor="inputAge2"></Label>
        <Input id = "inputAge2" placeholder="Enter age" value="{oModel>/age}"></Input>
        <HBox>
            <Button text="Save" type="Emphasized" press="onAddEmpDialogSavePress"></Button>
            <Button text="Cancel" press="onAddEmpDialogCancelPress"></Button>
        </HBox>
    </Dialog>
</core:FragmentDefinition>