<mvc:View controllerName="projectlearning.controller.View1" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m">
    <Page>

        <content>

            <Button text="Testing button" type="Success" press="onSubmit"></Button>

            <!--  Changing the binding path of controlls of this view because now the local model is moved to component level and there were multiple models in 
                the Component.js file, so we defined our moved model as a named/aliased model there as "this.setModel(model, "empModel")"
                Remember: now since this View1 have no local model so it will inherit the model from component level and component level have multiple models
                means this view is inheriting multiple models as well that's why bindings needs to be specified.
            -->
            <!-- Removed the previous List declaration and added new List implementation with CustomListItem to add buttons to each List item
                because StandardListItem does not support adding buttons to each list item,
                previous implementation was:
                <List items="{empModel>/employees}" > 
                    <StandardListItem title="{empModel>name}" info="{empModel>age}" press="onEmpListItemPress4" type="Active"></StandardListItem>
                </List>
            -->

            <List items="{empModel>/employees}">
                <CustomListItem>
                    <HBox justifyContent="SpaceBetween">
                        <Text text="{empModel>name}"></Text>
                        <HBox>
                            <Button text="View" press="onEmpListItemPress4"></Button>
                            <Button text="Delete" type="Reject" press="onEmpListItemDelete"></Button>
                        </HBox>
                    </HBox>
                </CustomListItem>
            </List>

            <!-- Two-way binding demonstration 
            here we are binding input and text control to the same model property, to demostrate two way binding.
            -->
            <HBox >
                <Input value="{empModel>/employeeForm/name}"> </Input>
                <Text text="{empModel>/employeeForm/name}"></Text>
            </HBox>
            
            <VBox id="addEmpVBox">
                <HBox>
                    <Button text="Add Employee via Dialog" press="onAddEmpPress2"></Button>
                    <Button text="Add Employee via VBox" press="onAddEmpPress1"></Button>
                </HBox>
            </VBox>

            <HBox >
                <Button text="Go to View2" press="onNavigateToVew2"></Button>
            </HBox>
        </content>
    </Page>
</mvc:View>